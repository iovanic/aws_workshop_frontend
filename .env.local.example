# Nombre de la tienda (por defecto: Next Drones).
# Se lee en tiempo de ejecución (reinicia `npm run dev` tras cambiar).
# También puedes usar SHOP_NAME (mismo efecto, sin prefijo NEXT_PUBLIC_).
NEXT_PUBLIC_SHOP_NAME=Next Drones

# Sprint 3–4: URL base de API Gateway (stage prod), sin barra final opcional.
# Ejemplo: https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod
NEXT_PUBLIC_API_GW_URL=

# Cognito (mismo pool y app client `shop-user-client` que en el taller).
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=

# Solo en el contenedor / servidor: URL base del FastAPI (sin barra final) para
# catálogo público sin JWT (GET /products). Ej.: http://ec2-xx-xx.compute-1.amazonaws.com:8000
SERVER_FASTAPI_ORIGIN=
